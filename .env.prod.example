# Copie para .env.prod NA VPS e preencha. O .env.prod nao vai para o git.
#
#   cp .env.prod.example .env.prod && nano .env.prod
#
# Gere a senha em vez de inventar uma:
#   openssl rand -base64 32

# O dominio que aponta para a VPS. Com um dominio aqui, o Caddy emite o
# certificado e serve HTTPS sozinho - e e isso que habilita o PWA, porque
# service worker so roda em contexto seguro.
#
# Para validar a stack sem dominio, use `:80` (HTTP puro, sem certificado).
SITE_ADDRESS=banco.seudominio.com

POSTGRES_DB=banco
POSTGRES_USER=banco
POSTGRES_PASSWORD=

# --- Somente se a VPS ja tem um proxy reverso na borda ---------------------
#
# Nesse caso 80/443 estao ocupadas e o TLS nao e deste projeto. Suba com a
# sobreposicao e deixe SITE_ADDRESS=:80 acima:
#
#   docker compose -f docker-compose.prod.yml -f docker-compose.proxy.yml up -d --build
#
# Passo a passo e a armadilha do SSE em docs/DEPLOY.md secao 8.

# Rede docker em que o proxy da borda ja esta. Para descobrir:
#   docker inspect <container-do-proxy> \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
EDGE_NETWORK=

# Apelido pelo qual o proxy encontra este projeto nessa rede.
WEB_ALIAS=banco-web

# --- Opcional: tetos de memoria -------------------------------------------
# Os defaults (backend 1g, postgres 512m) estao no docker-compose.prod.yml e
# servem bem a esta stack. Ajuste se a VPS for compartilhada e apertada, ou se
# for dedicada e houver folga. O heap da JVM sai de 75% do limite do backend.
# BACKEND_MEM_LIMIT=1g
# WEB_MEM_LIMIT=128m
# POSTGRES_MEM_LIMIT=512m

# Senha do Redis, que guarda as sessoes. Gere como a do Postgres:
#   openssl rand -base64 32
REDIS_PASSWORD=

# --- Demonstracao publica ------------------------------------------------
# Liga a entrada de visitante e as contas de demonstracao. Sem estas duas
# senhas a aplicacao NAO sobe com a demonstracao ligada: credencial previsivel
# e pior do que falhar na subida.
BANCO_DEMO_ENABLED=true
BANCO_DEMO_PASSWORD=
BANCO_DEMO_TRANSACTION_PASSWORD=

# ---------------------------------------------------------------------------
# E-mail transacional (Resend)
#
# ANTES de ligar: verifique o dominio em resend.com/domains e gere a chave em
# resend.com/api-keys. Sem dominio verificado o Resend so entrega para o
# e-mail da propria conta, e todo o resto volta com 403.
#
# BANCO_EMAIL_FROM precisa usar o dominio que voce verificou.
#
# Desligado, a fila continua sendo escrita e nada se perde: ao ligar, o que
# estiver pendente ha menos de BANCO_EMAIL_MAX_AGE_HOURS sai sozinho.
# ---------------------------------------------------------------------------
BANCO_EMAIL_ENABLED=false
BANCO_EMAIL_API_KEY=
BANCO_EMAIL_FROM=Banco <banco@bank.devfly.net>

# Quantas tentativas antes de desistir, e por quanto tempo uma mensagem parada
# ainda vale a pena ser enviada.
BANCO_EMAIL_MAX_ATTEMPTS=6
BANCO_EMAIL_MAX_AGE_HOURS=24
