# ---------------------------------------------------------------------------
# Borda da aplicacao.
#
# Este container faz duas coisas: serve o build estatico do React e repassa
# /api para o backend pela rede interna do compose. O navegador ve UMA origem
# so, o que mata CORS por construcao e mantem o SSE na mesma origem do app.
#
# SITE_ADDRESS decide o modo:
#   :80                      -> HTTP puro, para validar a stack localmente
#   banco.seudominio.com     -> o Caddy emite e renova o certificado sozinho
#
# Sem `email` global o Let's Encrypt emite normalmente; voce apenas nao recebe
# aviso de expiracao (o Caddy renova sem depender disso). Para receber, some
# um bloco no topo deste arquivo:  { email voce@dominio.com }
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Quando ha OUTRO proxy na frente deste Caddy - e aqui ha: o Caddy da borda
# termina o TLS e repassa em HTTP puro - este Caddy, por padrao, SOBRESCREVE
# o X-Forwarded-Proto com o esquema que ele mesmo recebeu, "http". O backend
# entao conclui que a origem nao era HTTPS e manda o cookie de sessao SEM
# `Secure`, sem erro nenhum em lugar nenhum.
#
# Com `trusted_proxies`, os X-Forwarded-* de um par confiavel sao preservados.
# `private_ranges` cobre a rede interna do compose, que e por onde a borda
# fala com este container; a porta deste Caddy nao esta publicada no host.
# ---------------------------------------------------------------------------
{
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS} {
	header {
		# Nao anunciar o servidor nem deixar o navegador adivinhar tipo de
		# arquivo - duas linhas, dois vetores de ataque menos.
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# O cookie de sessao sai com Secure, mas a PRIMEIRA visita a http://
		# acontece antes de qualquer redirecionamento - e e ela que pode
		# levar o cookie em texto claro. O HSTS faz o navegador nunca mais
		# tentar http:// neste host. So vale sob TLS: com SITE_ADDRESS=:80
		# os navegadores ignoram o cabecalho.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Cache, em duas regras MUTUAMENTE EXCLUSIVAS.
	#
	# Elas nao se sobrepoem de proposito. Duas regras `header` que casam o mesmo
	# caminho dependem de uma ordem de aplicacao que nao e obvia: com uma global
	# mais uma especifica para /assets/*, a global venceu e os bundles sairam
	# com no-cache. Com `not`, cada resposta casa exatamente uma regra.

	# Os bundles do Vite tem hash no nome, entao um deploy novo gera nomes novos
	# e os antigos podem ser cacheados para sempre.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Todo o resto revalida. `no-cache` nao proibe guardar, exige revalidar - o
	# custo de um acerto e um 304. Sem header nenhum, o navegador aplica cache
	# HEURISTICO a partir do Last-Modified e passa a servir o index.html antigo
	# depois de um deploy: o app fica preso numa versao velha, o sw.js nunca
	# atualiza, e nada disso aparece em log - do lado do servidor esta tudo certo.
	@demais not path /assets/*
	header @demais Cache-Control "no-cache"

	# -----------------------------------------------------------------------
	# SSE - a armadilha que quebra em silencio.
	#
	# Um proxy que acumula a resposta antes de repassar transforma um fluxo de
	# eventos em nada: o navegador conecta, o backend manda o evento, e o proxy
	# segura tudo esperando o fim de um corpo que nunca termina. Nao da erro,
	# nao aparece no log, a conexao fica aberta. Simplesmente nao chega.
	#
	# flush_interval -1 manda repassar cada byte na hora.
	#
	# O emitter do backend tem timeout de 30 minutos, e o reverse_proxy do
	# Caddy nao impoe timeout de resposta - a conexao vive o tempo que o
	# backend quiser.
	# -----------------------------------------------------------------------
	@sse path /api/notifications/stream
	handle @sse {
		# Rede de seguranca para quando ha OUTRO proxy na frente deste Caddy.
		# O nginx le X-Accel-Buffering: no na resposta do upstream e desliga o
		# buffering por conta propria - sem isso, um nginx com buffering padrao
		# acumula o stream e o cliente nao recebe nada ate a conexao fechar.
		# Nao substitui configurar o proxy: quem esta na frente pode nao ser nginx.
		header {
			X-Accel-Buffering no
			Cache-Control no-cache
		}
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		# A compressao fica AQUI, nao no nivel do site, de proposito: comprimir
		# e acumular bytes, e acumular bytes e exatamente o que nao pode
		# acontecer com o stream acima.
		encode zstd gzip

		root * /srv
		# SPA: rota desconhecida devolve o index e o roteamento acontece no
		# navegador.
		try_files {path} /index.html
		file_server
	}
}
