# Copie para .env e ajuste. O .env NÃO vai para o repositório.
#
# Em desenvolvimento local você pode ignorar este arquivo: os defaults do
# docker-compose e do application.yml já apontam para o Postgres descartável.
# Em servidor, defina todas as variáveis com valores próprios.

POSTGRES_DB=banco
POSTGRES_USER=banco
POSTGRES_PASSWORD=troque-esta-senha

DB_URL=jdbc:postgresql://localhost:5432/banco
DB_USER=banco
DB_PASSWORD=troque-esta-senha

# Demonstracao em desenvolvimento: entrada de visitante nas contas semeadas.
BANCO_DEMO_ENABLED=true
BANCO_DEMO_PASSWORD=demo-local
BANCO_DEMO_TRANSACTION_PASSWORD=123456
