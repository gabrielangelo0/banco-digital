# Copie para .env e ajuste. O .env NÃO vai para o repositório.
#
# Em desenvolvimento local você pode ignorar este arquivo: os defaults do
# docker-compose e do application.yml já apontam para o Postgres descartável.
# Em servidor, defina todas as variáveis com valores próprios.

POSTGRES_DB=banco
POSTGRES_USER=banco
POSTGRES_PASSWORD=troque-esta-senha

DB_URL=jdbc:postgresql://localhost:5432/banco
DB_USER=banco
DB_PASSWORD=troque-esta-senha

# Demonstracao em desenvolvimento: entrada de visitante nas contas semeadas.
BANCO_DEMO_ENABLED=true
BANCO_DEMO_PASSWORD=demo-local
BANCO_DEMO_TRANSACTION_PASSWORD=123456

# Se a sua maquina ja tem um Redis na 6379, aponte as duas para outra porta:
# REDIS_HOST_PORT=6380
# REDIS_PORT=6380

# E-mail transacional pelo Resend.
#
# A fila SEMPRE e escrita; esta chave liga apenas quem ENTREGA. Desligada, as
# mensagens se acumulam em PENDING e nada sai - entao em desenvolvimento
# ninguem manda e-mail sem querer, e nada se perde quando voce ligar.
#
# Para valer em servidor: verifique o dominio no Resend (sem isso ele so
# entrega para o e-mail da propria conta) e gere a chave em resend.com/api-keys.
BANCO_EMAIL_ENABLED=false
BANCO_EMAIL_API_KEY=
BANCO_EMAIL_FROM=Banco <banco@bank.devfly.net>
